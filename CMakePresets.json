{
	"version": 2,
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {}
		},
		{
			"name": "debug",
			"inherits": "common",
			"binaryDir": "build-ninja-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"inherits": "common",
			"binaryDir": "build-ninja-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "msvc-debug",
			"inherits": "debug",
			"generator": "Visual Studio 17 2022",
			"binaryDir": "build-debug"
		},
		{
			"name": "msvc-release",
			"inherits": "release",
			"generator": "Visual Studio 17 2022",
			"binaryDir": "build-msvc-release"
		},
		{
			"name": "mingw-debug",
			"inherits": "debug",
			"generator": "MinGW Makefiles",
			"binaryDir": "build-mingw-debug"
		},
		{
			"name": "mingw-release",
			"inherits": "release",
			"generator": "MinGW Makefiles",
			"binaryDir": "build-mingw-release"
		}
	]
}
